<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- سياق الطلب يلزم لمعرفة المستخدم الداخل، ومنه العميل الذي يعمل عليه. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- ملفات اللغة تُشحن مع البناء. حزمة Tesseract.Data.English تتكفّل
         بالإنجليزية، والعربية تُضاف هنا: أوراق الموردين عربية، وقراءتها
         بالإنجليزية وحدها هي ما كان يُسقط المحرك المحلي فيُحال كل مستند
         إلى السحابة. -->
    <Content Include="tessdata\*.traineddata">
      <Link>tessdata\%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YelgLens.Intake.Model\YelgLens.Intake.Model.csproj" />
    <ProjectReference Include="..\YelgLens.Intake.DAL\YelgLens.Intake.DAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.45.0" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tesseract.Data.English" Version="4.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
