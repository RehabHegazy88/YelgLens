# ---------- مخرجات البناء ----------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ---------- ملفات المحرِّر ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.swp

# ---------- الأسرار ----------
# القاعدة: لا مفتاح ولا كلمة سر في ملفٍ يُنسخ ويُرفع. مكانها user-secrets
# محلياً ومتغيّرات البيئة على الخادم.
appsettings.*.local.json
appsettings.Production.json
secrets.json
*.pfx
*.key

# ---------- مستندات العملاء ----------
# مستنداتٌ حقيقية فيها أسماءٌ وأسعارٌ وأرقام. مكانها القرص لا المستودع،
# والمجلد نفسه يبقى ليجده التطبيق عند أول تشغيل.
YelgLens.Intake.PL/Storage/*
!YelgLens.Intake.PL/Storage/.gitkeep

# ---------- بيانات Tesseract ----------
*.traineddata

# ---------- متفرقات ----------
*.db
*.db-shm
*.db-wal
Thumbs.db
.DS_Store

# سكربت تهيئة محلي — يُولَّد عند الحاجة ولا يُحفظ
setup-local-db.ps1

# وصل قاعدة التطوير المحلية — فيه كلمة سر، فلا يدخل المستودع
appsettings.Development.json
set-local-connection.ps1

# ناتج النشر — يُبنى ولا يُحفظ
publish/
publish-linux/
